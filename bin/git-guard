#!/usr/bin/env bash
# git-guard -- install / check / audit git leak-guard hooks
#   git-guard install [dirs...]   hook existing repos (scans $GUARD_SCAN_ROOTS or ~ by default)
#   git-guard status              show global config, rules, and hooked repos
#   git-guard audit  [dirs...]    audit committed content (file names only, never prints content)
#   git-guard snapshot            rebuild the runtime file fingerprint manifest
#   git-guard check <files...>    dry run: would these files be blocked (for tuning rules)
set -u
GUARD_ROOT="${GUARD_ROOT:-$HOME/.config/git}"
GUARD_DIR="${GUARD_DIR:-$GUARD_ROOT/guard}"
BIN_DIR="${GUARD_BIN_DIR:-$HOME/bin}"
TEMPLATE_HOOKS="$GUARD_ROOT/template/hooks"
. "$GUARD_ROOT/guard-lib.sh" || { echo "git-guard: cannot find $GUARD_ROOT/guard-lib.sh" >&2; exit 1; }

# Directories excluded from scanning (regex); override via $GUARD_DIR/exclude-dirs.txt
exclude_re() {
  if [ -f "$GUARD_DIR/exclude-dirs.txt" ]; then g_pats "$GUARD_DIR/exclude-dirs.txt" | paste -sd'|' -;
  else echo 'node_modules|\.gradle|\.cache|\.cargo|\.npm|\.bun|\.venv|\.tox|dist|build'; fi
}

find_repos() {
  local roots=("$@") r
  [ ${#roots[@]} -eq 0 ] && roots=(${GUARD_SCAN_ROOTS:-$HOME})
  for r in "${roots[@]}"; do
    [ -d "$r" ] || continue
    find "$r" -maxdepth 5 -name .git -prune -print 2>/dev/null
  done | sed 's|/\.git$||' | grep -vE "/($(exclude_re))($|/)" | sort -u
}

# Only hook "own" repos: no remote / remote in owners.txt / self-hosted remote
repo_is_ours() {
  local d="$1" url sp p
  sp=$(git -C "$d" rev-parse --show-superproject-working-tree 2>/dev/null) || sp=""
  [ -n "$sp" ] && return 1
  url=$(git -C "$d" config --get remote.origin.url 2>/dev/null) || url=""
  [ -z "$url" ] && return 0
  if [ -f "$GUARD_DIR/owners.txt" ]; then
    while IFS= read -r p; do
      case "$p" in ''|'#'*) continue;; esac
      case "$url" in *"$p"*) return 0;; esac
    done < "$GUARD_DIR/owners.txt"
  fi
  case "$url" in
    *github.com/*|*gitlab.com/*|*bitbucket.org/*) return 1;;   # leave third-party open-source repos alone
    *) return 0;;                                             # treat self-hosted/private remotes as ours
  esac
}

apply_exclude() {
  local d="$1" ex="$1/.git/info/exclude"
  mkdir -p "$d/.git/info" || return 0
  touch "$ex"
  sed -i '/^# >>> git-guard/,/^# <<< git-guard/d' "$ex" 2>/dev/null
  cat "$GUARD_ROOT/template/info/exclude" >> "$ex"
}

cmd_install() {
  local repos=() d h n=0
  mapfile -t repos < <(find_repos "$@")
  for d in "${repos[@]}"; do
    [ -d "$d/.git" ] || continue
    repo_is_ours "$d" || continue
    for h in pre-commit pre-push; do
      local dst="$d/.git/hooks/$h"
      if [ -e "$dst" ] && [ ! -L "$dst" ]; then cp -p "$dst" "$dst.bak-$(date +%s)"; fi
      ln -sfn "$TEMPLATE_HOOKS/$h" "$dst"
    done
    apply_exclude "$d"
    n=$((n+1)); echo "  hooked+exclude: ${d/#$HOME/~}"
  done
  echo "Installed git-guard into $n repo(s) (hooks + index-level ignores)"
  echo "If an open-source repo was skipped by mistake, add its remote prefix to $GUARD_DIR/owners.txt"
}

cmd_status() {
  echo "init.templateDir = $(git config --global --get init.templateDir)"
  echo "core.excludesFile = $(git config --global --get core.excludesFile)"
  echo "Protected roots:"; grep -v '^[[:space:]]*#' "$GUARD_DIR/protected-roots.txt" 2>/dev/null | sed 's/^/  /'
  echo "Hooked repos:"
  local d
  while IFS= read -r d; do
    [ -L "$d/.git/hooks/pre-commit" ] && echo "  ${d/#$HOME/~}"
  done < <(find_repos)
}

cmd_audit() {
  local repos=() d head i hits=0
  mapfile -t repos < <(find_repos "$@")
  echo "Auditing ${#repos[@]} repo(s)…"
  for d in "${repos[@]}"; do
    [ -d "$d/.git" ] || continue
    pushd "$d" >/dev/null 2>&1 || continue
    head=$(git rev-parse HEAD 2>/dev/null) || { popd >/dev/null; continue; }
    __g_blocked=0; __g_files=(); __g_reasons=()
    g_scan_tree "$head"
    if [ "$__g_blocked" -eq 1 ]; then
      for i in "${!__g_files[@]}"; do
        echo "  [${__g_reasons[$i]}] ${d/#$HOME/~}/${__g_files[$i]}"
        hits=$((hits+1))
      done
    fi
    popd >/dev/null
  done
  echo "Done. $hits hit(s) (file names only, content never printed)."
  echo "Cleanup: git rm --cached <file> && echo '<pattern>' >> .gitignore"
  echo "Secrets that were already pushed must be revoked immediately; scrub history with git filter-repo / BFG."
}

cmd_snapshot() { g_fp_snapshot; }

# Dry run: would a path be blocked (no repo changes; for tuning rules)
cmd_check() {
  [ "$#" -gt 0 ] || { echo "Usage: git-guard check <files...>" >&2; exit 2; }
  local top f rel
  top=$(git rev-parse --show-toplevel 2>/dev/null) || top=""
  trap 'g_tmpclean' EXIT
  __g_blocked=0; __g_files=(); __g_reasons=()
  for f in "$@"; do
    [ -e "$f" ] || { echo "  ? $f  (not found)" >&2; continue; }
    # Normalize to a repo-relative path: strip the repo root prefix from absolute paths, keep the rest as-is
    if [ -n "$top" ] && [ "${f#"$top"/}" != "$f" ]; then
      rel="${f#"$top"/}"
    elif [ "${f#/}" != "$f" ]; then
      rel="${f#/}"
    else
      rel="$f"
    fi
    g_check_path "$rel"
    if [ -d "$f" ]; then
      echo "  ! $rel  (directory; path check only)"
      continue
    fi
    g_check_size "$rel" "$(stat -c %s "$f" 2>/dev/null || echo 0)"
    g_check_content_file "$rel" "$f"
    g_check_fingerprint_file "$rel" "$f"
  done
  if [ "$__g_blocked" -eq 0 ]; then
    echo "放行：$*"
    return 0
  fi
  local i
  for i in "${!__g_files[@]}"; do
    printf '  x %s\n      -> %s\n' "${__g_files[$i]}" "${__g_reasons[$i]}"
  done
  return 1
}

case "${1:-status}" in
  check)    shift; cmd_check "$@";;
  snapshot) cmd_snapshot;;
  install)  shift; cmd_install "$@";;
  status)   cmd_status;;
  audit)    shift; cmd_audit "$@";;
  *) echo "Usage: git-guard {install|status|audit|snapshot|check} [args...]"; exit 2;;
esac
